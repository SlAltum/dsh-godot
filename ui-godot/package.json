{
  "name": "@deepseek-ai/dsh-ui-godot",
  "description": "Godot browser surface for the Web client: the settings card for the godot namespace and the sandbox watch panel (floating ball, live MJPEG frame, click-to-drive)",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/godot/ui-godot"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./assets/*": "./lib/assets/*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/assets",
    "!**/*.map"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-locale": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-store": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-alpha.3",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-store": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-layout": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-plugin-manager": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-locale": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-store": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-tool": "0.2.2-rc.1",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.31",
    "@types/react-dom": "18.3.0",
    "immer": "10.1.1",
    "jsdom": "^26.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.15.0",
    "vitest": "^3.2.0",
    "zustand": "~4.5.7"
  }
}
