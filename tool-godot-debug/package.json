{
  "name": "@deepseek-ai/dsh-tool-godot-debug",
  "description": "Model-facing Godot debug tool (godot_debug): one bounded scripted debug run \u2014 CLI breakpoints, headless launch over --remote-debug, per-stop stack/variable snapshots, auto-continue, structured report",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/godot/tool-godot-debug"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-util-values": "^0.2.2-alpha.3",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-llm": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-lsp-godot": "workspace:^",
    "@deepseek-ai/dsh-subprocess": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-system-prompt": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-timeout": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-tool-godot": "workspace:^",
    "@deepseek-ai/dsh-tools": "^0.2.2-alpha.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-llm": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-lsp-godot": "workspace:^",
    "@deepseek-ai/dsh-subprocess": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-subprocess-local": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-system-prompt": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-timeout": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-tool-call-timeout-policy": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-godot": "workspace:^",
    "@deepseek-ai/dsh-tools": "^0.2.2-alpha.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  }
}
