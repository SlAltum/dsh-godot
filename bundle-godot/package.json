{
  "name": "@deepseek-ai/dsh-godot-bundle",
  "description": "Godot capability bundle: headless tools, GDScript LSP, the debugger, the visual sandbox, and the browser surface",
  "version": "0.2.2-alpha.2",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/godot/bundle-godot"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon.svg": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-lsp-godot": "workspace:^",
    "@deepseek-ai/dsh-tool-godot": "workspace:^",
    "@deepseek-ai/dsh-tool-godot-debug": "workspace:^",
    "@deepseek-ai/dsh-tool-godot-ego": "workspace:^",
    "@deepseek-ai/dsh-ui-godot": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
}
