    "@deepseek-ai/dsh-subprocess": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-system-prompt": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-timeout": "^0.2.2-alpha.3",
