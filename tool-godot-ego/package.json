    "@deepseek-ai/dsh-tool-godot": "workspace:^",
    "@deepseek-ai/dsh-tools": "^0.2.2-alpha.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-attachment": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-llm": "^0.2.2-alpha.3",
